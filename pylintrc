[MASTER]

jobs=0
persistent=yes
logging-format-style=new
disable=logging-fstring-interpolation

[REPORTS]

output-format=text

[BASIC]

# i, j, k are frequently used to denote list indices
# f is frequently used to denote a file pointer 
good-names=i, j, k, f, ax, fp

[DESIGN]
max-locals=30
min-public-methods=1
